<?xml version="1.0" encoding="utf-8"?>
<!-- L'écran de lancement natif, affiché avant que Flutter ait rendu sa
     première frame. Le fond est celui de l'application, et le logo est le
     même que celui de l'accueil : le démarrage doit ressembler à l'entrée
     dans le jeu, pas à un flash blanc suivi d'autre chose. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
