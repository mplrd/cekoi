<?xml version="1.0" encoding="utf-8"?>
<!-- Le jumeau sombre de `values-v31/styles.xml`, qui porte l explication du
     choix de `splash_icon`. Les deux ne doivent differer que par le theme
     parent — `tool/test_ressources_android.py` le verifie.

     **Pourquoi ce fichier doit exister.** Le qualificatif de mode nuit passe
     avant le niveau d API dans l ordre de precedence des ressources. Si
     `values-night/styles.xml` existe et que celui-ci disparait, un appareil en
     API 31+ et en theme sombre resout `LaunchTheme` vers `values-night`, qui
     ne declare aucun attribut de splash : l icone disparait alors entierement
     de l ecran de demarrage. Les deux fichiers `night` vont ensemble ; en
     supprimer un seul regresse en silence. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
