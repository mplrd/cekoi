{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub add:*)",
      "Bash(flutter pub outdated:*)",
      "Bash(flutter doctor:*)",
      "Bash(flutter --version)",
      "Bash(flutter clean)",
      "Bash(dart --version)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart test:*)",
      "Bash(dart run build_runner:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(flutter build:*)"
    ]
  }
}
