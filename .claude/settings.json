{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter pub add:*)",
      "Bash(flutter pub upgrade:*)",
      "Bash(flutter pub outdated:*)",
      "Bash(flutter create:*)",
      "Bash(flutter gen-l10n:*)",
      "Bash(flutter doctor:*)",
      "Bash(flutter devices:*)",
      "Bash(flutter emulators:*)",
      "Bash(flutter --version)",
      "Bash(flutter clean)",
      "Bash(dart --version)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart test:*)",
      "Bash(dart fix:*)",
      "Bash(dart pub:*)",
      "Bash(dart run build_runner:*)",
      "Bash(dart run tool/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git worktree:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git describe:*)",
      "Bash(git blame:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo view:*)",
      "Bash(gh browse:*)",
      "Bash(gh auth status:*)"
    ],
    "ask": [
      "Bash(flutter build:*)",
      "Bash(gh api:*)",
      "Bash(gh release:*)",
      "Bash(winget install:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin :main)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D main)",
      "Bash(git branch -D develop)",
      "Bash(gh repo delete:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh secret:*)",
      "Read(./android/key.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
